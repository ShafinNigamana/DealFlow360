{
	"info": {
		"_postman_id": "dealflow360-api-collection",
		"name": "DealFlow360 API Suite",
		"description": "Comprehensive Postman test collection for DealFlow360 B2B Sales Operations Platform with full CRUD & Action Endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.add({key: 'x-user-email', value: pm.environment.get('adminEmail') || 'admin@dealflow360.com'});"
				]
			}
		}
	],
