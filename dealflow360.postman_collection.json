					"name": "Get Dashboard KPIs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dashboard",
							"host": ["{{baseUrl}}"],
							"path": ["api", "dashboard"]
						}
					}
				},
				{
					"name": "Get Deal Health Alerts",
