						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"REPLACE_WITH_CUSTOMER_ID\",\n  \"repId\": \"REPLACE_WITH_REP_USER_ID\"\n}"
						},
						"url": {
