						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"REPLACE_WITH_PRODUCT_ID\",\n  \"quantity\": 5,\n  \"unitDiscountPercent\": 15.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/quotations/{{quotationId}}/lines",
